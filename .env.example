# Copia este archivo a .env  (NUNCA subas .env a Git)

# --- Base de datos ---
# Opción 1 (Nube - Neon PostgreSQL): pega tu Connection String de Neon (el backend convierte postgresql:// a postgresql+psycopg:// automáticamente)
# DATABASE_URL=postgresql://USUARIO:CLAVE@EP-TU-PROYECTO-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Opción 2 (PostgreSQL local en Docker): si dejas DATABASE_URL sin definir, docker compose usa el contenedor db automáticamente.
POSTGRES_USER=saturna
POSTGRES_PASSWORD=saturna
POSTGRES_DB=saturna
POSTGRES_PORT=5433
POSTGRES_BIND_IP=0.0.0.0
# Para correr la API fuera de Docker contra el Postgres local de Docker:
# DATABASE_URL=postgresql+psycopg://saturna:saturna@localhost:5433/saturna
# Sin Docker (solo desarrollo rápido):
# DATABASE_URL=sqlite:///./saturna.db

# --- Seguridad ---
# development | test | production
ENVIRONMENT=development
# Obligatorio en production: mínimo 32 caracteres
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES
# Duración de sesiones
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Vigencia predeterminada de los QR
QR_TOKEN_TTL_HOURS=24
# Orígenes del frontend permitidos (agrega la URL HTTPS de Render cuando la publiques)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# URL pública HTTPS de la API (ej. https://saturna-api.onrender.com)
PUBLIC_BASE_URL=http://localhost:8000

# --- WhatsApp Cloud API (vacío = modo simulado: los mensajes solo se registran en el log) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=saturna-verify
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_ARRIVAL=aviso_llegada

# --- Agente de IA (vacío = agente por reglas, sin costo; soporta Google Gemini o Anthropic) ---
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
